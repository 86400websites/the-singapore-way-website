# Copy this file to .env.local and fill in real values from the Supabase dashboard.
# .env.local is gitignored and must never be committed.

# Canonical public origin for the deployed site (no trailing slash).
# Used by metadataBase, sitemap.ts, robots.ts, the OG image, and auth redirect helpers.
# Local default: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL - e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key - safe to expose in the browser.
# Do NOT use the service-role / secret key here. Never put service-role keys in frontend code.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Mailchimp - server-only. Never expose these with NEXT_PUBLIC_.
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=

# Resend - server-only. Never expose these with NEXT_PUBLIC_.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=

# Sentry - error tracking.
# NEXT_PUBLIC_SENTRY_DSN is safe to expose in the browser; the others are server/build-time only.
# When NEXT_PUBLIC_SENTRY_DSN is empty, Sentry is a no-op and the app builds and runs without it.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# PostHog - product analytics + session replay.
# Both variables are public; when NEXT_PUBLIC_POSTHOG_KEY is empty, PostHog is a no-op.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Upstash Redis - per-IP rate limiting on /api/newsletter and /api/contact.
# When either variable is empty, the rate limiter no-ops (dev/preview without Redis still works).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile - CAPTCHA on public forms (Footer newsletter + request modal).
# When NEXT_PUBLIC_TURNSTILE_SITE_KEY is empty the widget is hidden; when
# TURNSTILE_SECRET_KEY is empty the server-side verification is skipped.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
