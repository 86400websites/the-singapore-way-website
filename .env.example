# Copy this file to .env.local and fill in real values from the Supabase dashboard.
# .env.local is gitignored and must never be committed.

# Supabase project URL — e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase publishable (anon-equivalent) key — safe to expose in the browser.
# Do NOT use the service-role / secret key here. Never put service-role keys in frontend code.
VITE_SUPABASE_PUBLISHABLE_KEY=
